#!/bin/sh

ENV_FILE=/opt/etc/teplo/teplo.env
PIDFILE=/opt/var/run/teplo.pid
LOGFILE=/opt/var/log/teplo/teplo.log
PYTHON=/opt/share/teplo/venv/bin/python
MANAGE=/opt/share/teplo/current/app/manage.py
STOP_TIMEOUT=10

load_env() {
    set -a
    . "$ENV_FILE"
    set +a
}

running() {
    [ -f "$PIDFILE" ] && tr '\0' ' ' 2>/dev/null < "/proc/$(cat "$PIDFILE")/cmdline" | grep -q run_teplo
}

start() {
    running && return 0
    load_env
    start-stop-daemon -S -b -m -p "$PIDFILE" -O "$LOGFILE" -x /opt/bin/nice -- -n 10 "$PYTHON" "$MANAGE" run_teplo
}

stop() {
    running && kill "$(cat "$PIDFILE")"
    waited=0
    while running && [ "$waited" -lt "$STOP_TIMEOUT" ]; do
        sleep 1
        waited=$((waited + 1))
    done
    running && kill -9 "$(cat "$PIDFILE")"
    rm -f "$PIDFILE"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) if running; then echo running; else echo stopped; fi ;;
    *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
