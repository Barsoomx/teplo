[devices.thermostat-kitchen]
address = '192.0.2.10'
device_id = 'tuya-device-id'
local_key = 'tuya-local-key'
protocol = '3.3'

[devices.plug-boiler-1f]
address = '192.0.2.11'
device_id = 'tuya-device-id'
local_key = 'tuya-local-key'
protocol = '3.5'

[panel]
password = 'choose-a-panel-password'

# Telegram alerts: a bot token from BotFather and the chat that receives them; the proxy is optional.
# [telegram]
# token = 'bot-token'
# chat_id = 'chat-id'
# proxy = 'http://proxy.example:3128'

# ESPHome sensors: teplo's user on the Mosquitto broker on the router (docs/deploy.md, MQTT broker); port defaults to 1883.
# [mqtt]
# host = '192.168.1.1'
# port = 1883
# username = 'teplo'
# password = 'choose-a-teplo-password'
